# Copy this file to .env.local and fill in the values.
# Every variable here is PUBLIC (it is sent to the browser). This application
# has no server-side secret: never add a Supabase secret / service_role key.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The public origin of this app (no trailing slash). Used in auth emails and invite links.
#   local:      http://localhost:3000
#   production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Base URL for large resumable uploads. Leave unset: hosted projects
# automatically use https://<project-ref>.storage.supabase.co.
# NEXT_PUBLIC_SUPABASE_STORAGE_URL=

# Match Dashboard → Storage → Settings → Global file size limit.
# Leave unset locally to test the full 250 MB EPUB / 500 MB PDF ceilings.
# NEXT_PUBLIC_UPLOAD_LIMIT_MB=50
